---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
import Hero from "../components/Hero.astro";
import ProductCollection from "../components/ProductCollection.astro";
import Features from "../components/Features.astro";
---

<!doctype html>
<html lang="es">
    <head>
        <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    </head>
    <body class="bg-[#fdfdfd]">
        <div class="lg:max-w-6xl mx-auto">
            <Header />
            <main
                class="flex flex-col items-center justify-center text-[#1e1e1e] min-h-[600px]"
            >
                <div class="text-center p-4">
                    <h2 class="text-4xl">Verifica tu vela</h2>
                    <p class="opacity-60 text-sm">
                        Y enterate de todo acerca de su fabricacion.
                    </p>
                </div>

                <div class="flex flex-col lg:flex-row gap-4 items-center p-4">
                    <input
                        type="text"
                        placeholder="Codigo de tu vela"
                        class="placeholder-[#aaaaaa] text-[#1e1e1e] p-2 px-6 w-full lg:min-w-xs text-base rounded-3xl border border-[#eee]"
                    />
                    <button
                        class="text-base rounded-3xl p-2 px-10 bg-[#F6EEE8] text-[#1e1e1e]"
                        >Verificar</button
                    >
                </div>
            </main>
            <Footer />
        </div>
    </body>
</html>
