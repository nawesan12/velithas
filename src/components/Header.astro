---
import HeaderLink from "./HeaderLink.astro";
---

<header>
    <nav class="lg:max-w-7xl mx-auto py-4">
        <h2 class="text-4xl"><a href="/" class="text-3xl">Velithas.</a></h2>
        <div class="internal-links">
            <HeaderLink href="/">Inicio</HeaderLink>
            <HeaderLink href="/nosotros">Nosotros</HeaderLink>
            <HeaderLink href="/tienda">Tienda</HeaderLink>
            <HeaderLink href="/blog">Blog</HeaderLink>
        </div>

        <a href="/verificar" class="rounded-lg">
            <span class="sr-only">Verifica tu Velitha</span>
            VERIFICA TU VELA
        </a>
    </nav>
</header>
<style>
    header {
        margin: 0;
        padding: 0 1em;
    }
    h2 {
        margin: 0;
        font-size: 1em;
    }

    h2 a,
    h2 a.active {
        text-decoration: none;
    }
    nav {
        display: flex;
        align-items: center;
        justify-content: space-between;
    }
    nav a {
        padding: 1em 0.5em;
        color: var(--black);
        border-bottom: 2px solid transparent;
        text-decoration: none;
    }
    nav a.active {
        text-decoration: none;
        border-bottom-color: #fbf8f2;
    }
    .social-links,
    .social-links a {
        display: flex;
    }
    @media (max-width: 720px) {
        .social-links {
            display: none;
        }
    }
</style>
